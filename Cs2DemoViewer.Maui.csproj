<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<OutputType>Exe</OutputType>    
	  <TargetFrameworks>net10.0-android;net9.0-ios</TargetFrameworks>
    <RootNamespace>Cs2DemoViewer.Maui</RootNamespace>
	  <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
	  <AndroidFastDeployment>false</AndroidFastDeployment>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
	  <Nullable>enable</Nullable>
	  <AndroidSdkBuildToolsVersion>34.0.0</AndroidSdkBuildToolsVersion>
	  <AndroidSdkVersion>36</AndroidSdkVersion>

    <!-- App info -->
    <ApplicationTitle>CS2 Demo Viewer</ApplicationTitle>
    <ApplicationId>com.yourname.cs2demoviewer</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>

    <!-- Android -->
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
    <!-- iOS -->
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <!-- ========================
       ССЫЛКА НА ТВОИ DLL
       Скопируй все DLL в папку libs/ рядом с .csproj
  ======================== -->
  <ItemGroup>
    <Reference Include="Cs2DemoViewer.Core">
      <HintPath>libs\Cs2DemoViewer.Core.dll</HintPath>
    </Reference>
    <Reference Include="DemoFile">
      <HintPath>libs\DemoFile.dll</HintPath>
    </Reference>
    <Reference Include="DemoFile.Game.Cs">
      <HintPath>libs\DemoFile.Game.Cs.dll</HintPath>
    </Reference>
    <Reference Include="Google.Protobuf">
      <HintPath>libs\Google.Protobuf.dll</HintPath>
    </Reference>
    <Reference Include="protobuf-net">
      <HintPath>libs\protobuf-net.dll</HintPath>
    </Reference>
    <Reference Include="protobuf-net.Core">
      <HintPath>libs\protobuf-net.Core.dll</HintPath>
    </Reference>
    <Reference Include="Snappier">
      <HintPath>libs\Snappier.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- App icons -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#1a1a2e" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#1a1a2e" BaseSize="128,128" />

    <!-- Fonts -->
    <MauiFont Include="Resources\Fonts\*" />

    <!-- Images (карты CS2 кладёшь сюда) -->
    <MauiImage Include="Resources\Images\*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="9.0.*" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="CommunityToolkit.Maui" Version="9.1.0" />
	<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.0" />
  </ItemGroup>

</Project>
