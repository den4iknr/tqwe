<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Cs2DemoViewer.Maui.ViewModels"
             xmlns:models="clr-namespace:Cs2DemoViewer.Maui.Models"
             x:Class="Cs2DemoViewer.Maui.Views.DemoPage"
             x:DataType="vm:DemoViewModel"
             Title="{Binding Demo.MapName}">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Счёт матча -->
        <Frame Grid.Row="0" Style="{StaticResource CardStyle}" Margin="16,12,16,0">
            <Grid ColumnDefinitions="*,Auto,*">

                <!-- CT команда -->
                <VerticalStackLayout Grid.Column="0" Spacing="2">
                    <Label Text="{Binding Demo.CtClan}" FontSize="16" FontAttributes="Bold"
                           TextColor="{StaticResource TeamCT}" HorizontalOptions="Start" />
                    <Label Text="Counter-Terrorist" TextColor="#555577" FontSize="11" />
                </VerticalStackLayout>

                <!-- Счёт -->
                <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="0">
                    <Label TextColor="#ffffff" FontSize="32" FontAttributes="Bold"
                           HorizontalOptions="Center">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{Binding Demo.CtScore}" TextColor="#4a9eff" />
                                <Span Text=" : " TextColor="#ffffff" />
                                <Span Text="{Binding Demo.TScore}" TextColor="#ffaa00" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Label Text="{Binding Demo.RoundCount, StringFormat='{0} раундов'}"
                           TextColor="#555577" FontSize="11" HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- T команда -->
                <VerticalStackLayout Grid.Column="2" Spacing="2">
                    <Label Text="{Binding Demo.TClan}" FontSize="16" FontAttributes="Bold"
                           TextColor="{StaticResource TeamT}" HorizontalOptions="End" />
                    <Label Text="Terrorist" TextColor="#555577" FontSize="11"
                           HorizontalOptions="End" />
                </VerticalStackLayout>
            </Grid>
        </Frame>

        <!-- Заголовок списка -->
        <Label Grid.Row="1" Text="РАУНДЫ" FontSize="11" CharacterSpacing="2"
               TextColor="#555577" Margin="20,12,20,4" />

        <!-- Список раундов -->
        <CollectionView Grid.Row="2" ItemsSource="{Binding Rounds}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:RoundData">
                    <Frame Style="{StaticResource CardStyle}" Margin="16,3">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DemoViewModel}}, Path=OpenRoundCommand}"
                                CommandParameter="{Binding .}" />
                        </Frame.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">

                            <!-- Номер раунда -->
                            <Label Grid.Column="0"
                                   Text="{Binding Number, StringFormat='R{0}'}"
                                   FontSize="14" FontAttributes="Bold"
                                   TextColor="#aaaacc" WidthRequest="36"
                                   VerticalOptions="Center" />

                            <!-- Победитель и исход -->
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding WinnerLabel}" FontSize="14" FontAttributes="Bold">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding CtWon}" Value="True">
                                            <Setter Property="TextColor" Value="#4a9eff" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding CtWon}" Value="False">
                                            <Setter Property="TextColor" Value="#ffaa00" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Label Text="{Binding Outcome}" TextColor="#555577" FontSize="11" />
                            </VerticalStackLayout>

                            <!-- Счёт после раунда -->
                            <Label Grid.Column="2"
                                   Text="{Binding ScoreDisplay}"
                                   TextColor="#ffffff" FontSize="15" FontAttributes="Bold"
                                   VerticalOptions="Center" />

                            <!-- Стрелка -->
                            <Label Grid.Column="3" Text="›"
                                   TextColor="#555577" FontSize="22"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>
