<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Cs2DemoViewer.Maui.App">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Тёмная тема в стиле CS2 -->
            <Color x:Key="BackgroundDark">#0d0d1a</Color>
            <Color x:Key="BackgroundCard">#1a1a2e</Color>
            <Color x:Key="BackgroundSurface">#16213e</Color>
            <Color x:Key="AccentBlue">#0f3460</Color>
            <Color x:Key="AccentOrange">#e94560</Color>
            <Color x:Key="TextPrimary">#ffffff</Color>
            <Color x:Key="TextSecondary">#aaaacc</Color>
            <Color x:Key="TeamCT">#4a9eff</Color>
            <Color x:Key="TeamT">#ffaa00</Color>
            <Color x:Key="HealthGreen">#4caf50</Color>
            <Color x:Key="HealthRed">#f44336</Color>

            <!-- Стили -->
            <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
                <Setter Property="BackgroundColor" Value="{StaticResource BackgroundDark}" />
            </Style>

            <Style x:Key="CardStyle" TargetType="Frame">
                <Setter Property="BackgroundColor" Value="{StaticResource BackgroundCard}" />
                <Setter Property="BorderColor" Value="{StaticResource AccentBlue}" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="12" />
                <Setter Property="HasShadow" Value="True" />
            </Style>

            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource AccentOrange}" />
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="Padding" Value="16,10" />
            </Style>

            <Style x:Key="SecondaryButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource AccentBlue}" />
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="12,8" />
            </Style>

            <Style x:Key="HeadingLabel" TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontAttributes" Value="Bold" />
            </Style>

            <Style x:Key="SubLabel" TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
                <Setter Property="FontSize" Value="13" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
